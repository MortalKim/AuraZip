<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AuraZip</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AuraZip.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- Preserve Windows 11 shell-extension compatibility independently of API references. -->
    <AppxAddDefaultTargetDeviceFamilyItem>false</AppxAddDefaultTargetDeviceFamilyItem>
    <ShellPlatform Condition="'$(Platform)' == 'x86'">Win32</ShellPlatform>
    <ShellPlatform Condition="'$(ShellPlatform)' == ''">$(Platform)</ShellPlatform>
  </PropertyGroup>

  <ItemGroup>
    <TargetDeviceFamily Include="Windows.Desktop">
      <TargetPlatformMinVersion>$(TargetPlatformMinVersion)</TargetPlatformMinVersion>
      <TargetPlatformVersion>10.0.26226.0</TargetPlatformVersion>
    </TargetDeviceFamily>
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AuraZip.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Engine\$(Platform)\7z.exe" Link="Engine\7z.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Engine\$(Platform)\7z.dll" Link="Engine\7z.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdParty\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\en-US.json" />
    <EmbeddedResource Include="Resources\zh-CN.json" />
    <Content Include="..\AuraZip.Shell\bin\$(ShellPlatform)\$(Configuration)\AuraZip.Shell.dll" Link="AuraZip.Shell.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AuraZip.Core\AuraZip.Core.csproj" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- The IDE does not infer upload packaging from the Store association file. -->
    <UapAppxPackageBuildMode Condition="'$(UapAppxPackageBuildMode)' == '' and '$(Configuration)' == 'Release' and Exists('$(MSBuildProjectDirectory)\Package.StoreAssociation.xml')">StoreUpload</UapAppxPackageBuildMode>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Classic XAML bindings use WinRT metadata at runtime, including the language indexer. -->
    <PublishTrimmed>False</PublishTrimmed>
    <GenerateTemporaryStoreCertificate>False</GenerateTemporaryStoreCertificate>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <!-- Managed portable PDBs do not need the optional native FastLink symbol conversion. -->
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <AppxBundle>Always</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxBundlePlatforms>x86|x64</AppxBundlePlatforms>
  </PropertyGroup>
  <Target Name="BuildShellExtension" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Build-ShellExtension.ps1&quot; -Platform $(Platform) -Configuration $(Configuration)" />
  </Target>
</Project>
